{
  "name": "codivew-vscode",
  "displayName": "Codivew",
  "description": "%codivew.description%",
  "version": "0.1.1",
  "publisher": "knsan189",
  "license": "MIT",
  "icon": "media/codivew-icon-128.png",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codivew/vscode.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "codivew.reviewWorking",
        "title": "%command.reviewWorking%"
      },
      {
        "command": "codivew.reviewStaged",
        "title": "%command.reviewStaged%"
      },
      {
        "command": "codivew.reviewBranch",
        "title": "%command.reviewBranch%"
      },
      {
        "command": "codivew.openLatestReport",
        "title": "%command.openLatestReport%",
        "icon": "$(open-preview)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codivew",
          "title": "Codivew",
          "icon": "media/codivew.svg"
        }
      ]
    },
    "views": {
      "codivew": [
        {
          "type": "webview",
          "id": "codivew.reviewView",
          "name": "%view.codeReview%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codivew.openLatestReport",
          "when": "view == codivew.reviewView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Codivew",
      "properties": {
        "codivew.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "%config.ollamaUrl%"
        },
        "codivew.model": {
          "type": "string",
          "default": "qwen3.6:35b-a3b-coding-mxfp8",
          "description": "%config.model%"
        },
        "codivew.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "%config.baseBranch%"
        },
        "codivew.projectContext": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.projectContext%"
        },
        "codivew.maxDiffChars": {
          "type": "integer",
          "default": 120000,
          "minimum": 1000,
          "description": "%config.maxDiffChars%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.cjs\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.cjs\" \"*.{json,md,mjs}\"",
    "check": "npm run typecheck && npm run lint",
    "test:extension": "npm run build && node test/run-tests.mjs",
    "test:cursor": "npm run build && node test/run-tests.mjs --cursor",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "codivew": "^0.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^18.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "ovsx": "^1.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
